# URL base da API do Contrataê Bahia.
# Enquanto não estiver definida, a landing usa as categorias estáticas de src/data/categories.js
# e a busca/cadastro exibem estado vazio ou mensagem de indisponibilidade.
REACT_APP_API_URL=

# URL do app/painel de login. Enquanto vazia, o link "Entrar" do header fica oculto.
REACT_APP_APP_URL=

# Porta usada pelo servidor Express que serve o build (npm run serve)
PORT=53002
